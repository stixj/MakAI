# Vyplň alespoň jeden klíč. Žádné tajné hodnoty necommituj.
GEMINI_API_KEY=
OPENAI_API_KEY=

# auto preferuje Gemini; explicitní openai vždy používá OpenAI.
LLM_PROVIDER=auto
GEMINI_MODEL=gemini-3.5-flash
OPENAI_MODEL=gpt-4o-mini
# Fallback může účtovat OpenAI tokeny; zapni jej vědomě.
ALLOW_OPENAI_FALLBACK=false
LLM_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=4096

# Volitelné. Prázdná hodnota = lokální JSON, žádné DB připojení.
# Neon: postgresql://user:password@host/database?sslmode=require
DATABASE_URL=
LOCAL_RESULTS_PATH=data/results.json
